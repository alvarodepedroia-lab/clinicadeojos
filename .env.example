# ─── Van en Vercel (y en .env.local para desarrollo) ────────────────────────
# Supabase: solamente URL y clave publicable (browser-safe).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Dominio canónico del sitio (canonical, Open Graph, sitemap.xml y robots.txt).
# Mientras no exista clinicadeojossj.com.ar, poné acá la URL del deploy de Vercel.
# Si se deja vacío, el fallback del código es https://clinicadeojossj.com.ar
NEXT_PUBLIC_SITE_URL=

# ─── Opcional: aviso por correo de "olvidé mi contraseña" ───────────────────
# Sin esto el pedido igual queda registrado y visible en el panel, en Accesos.
# Es una clave de servidor: NO le pongas el prefijo NEXT_PUBLIC_.
RESEND_API_KEY=
RESEND_FROM=

# ─── Solo en tu máquina, NUNCA en Vercel ───────────────────────────────────
# La usa scripts/crear-usuarios.mjs para dar de alta al personal.
# Es la llave maestra de la base: si se filtra, se saltea todas las políticas
# de seguridad. Va únicamente en .env.local, que git ignora.
SUPABASE_SERVICE_ROLE_KEY=
